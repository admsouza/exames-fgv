{
  "name": "exames-fgv",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm --workspace @exames-fgv/api run start:dev",
    "dev:web": "npm --workspace @exames-fgv/web run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --workspace @exames-fgv/web run build",
    "build:api": "npm --workspace @exames-fgv/api run build",
    "start": "npm --workspace @exames-fgv/api run start:prod",
    "prisma:generate": "npm --workspace @exames-fgv/api run prisma:generate",
    "prisma:migrate:deploy": "npm --workspace @exames-fgv/api run prisma:migrate:deploy"
  }
}
